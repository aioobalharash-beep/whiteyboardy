# Copy this file to `.env` and fill in the values you need.
#
# tldraw licence key — required by tldraw ONLY for production builds
# (`npm run tauri build`). Without it, tldraw hides the whole editor a few
# seconds after launch, so the canvas goes blank while the rest of the app keeps
# running. Development (`npm run tauri dev`, `npm run dev`) never needs a key.
#
# Get one at https://tldraw.dev/pricing — a free 100-day trial licence is
# available, and it keeps the watermark visible.
VITE_TLDRAW_LICENSE_KEY=
